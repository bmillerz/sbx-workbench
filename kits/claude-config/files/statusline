#!/bin/sh
# Claude Code pipes the session JSON to the statusLine command. The claude
# mixin's own statusLine is sbx-claude-hook, which forwards it to sbx
# Desktop's status bar and prints nothing; replacing it outright would blank
# that view. Feed both: the hook in the background, ccstatusline for the
# terminal line.
input=$(cat)
if [ -x /usr/local/bin/sbx-claude-hook ]; then
  printf '%s' "$input" | /usr/local/bin/sbx-claude-hook claude-status >/dev/null 2>&1 &
fi
printf '%s' "$input" | /usr/local/bin/ccstatusline
